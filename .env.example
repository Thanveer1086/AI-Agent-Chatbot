# ==============================================================================
# AI-Agent-ChatBot Environment Configuration Template
# ==============================================================================

# LLM Providers (Choose 'gemini' or 'openai')
API_USED=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash

# Optional: OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Embedding Configuration (gemini or openai)
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=gemini-embedding-2
EXPECTED_EMBEDDING_DIM=1536

# Database & Storage
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/agent_chatbot
DB_POOL_MIN=2
DB_POOL_MAX=10
AZURE_STORAGE_CONNECTION_STRING=
AZURE_CONTAINER_NAME=documents
DEV_STORAGE_LOCAL_PATH=./storage/blobs

# Security & Authentication
DEV_AUTH_BYPASS=true
JWT_SECRET=super-secret-key-change-in-production
JWT_ALGORITHM=HS256

# Agent & Loop Guardrails
MAX_AGENT_ITERATIONS=5
TOOL_TIMEOUT_SECONDS=15
RERANKING_ENABLED=true
RERANK_TOP_K=5

# GitHub Copilot & Cloud MCP Integration
GITHUB_PAT=your-github-pat-token-here
GITHUB_USERNAME=your-github-username-here
