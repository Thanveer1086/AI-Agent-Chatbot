# ==============================================================================
# AI-Agent-ChatBot Environment Configuration Template
# ==============================================================================

# LLM Providers (Choose 'gemini' or 'openai')
API_USED=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite
# Tried in order if GEMINI_MODEL fails
GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-3.1-flash-lite
# Optional faster model for the planner step (defaults to the main model)
PLANNER_MODEL=

# Optional: OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Embeddings: choose ONE provider -> openai | gemini | qwen
#   qwen   = free local Hugging Face model (runs inside the backend, no API key)
#   gemini = Google Gemini API (needs GEMINI_API_KEY)
#   openai = OpenAI API (needs OPENAI_API_KEY)
# After changing the provider, re-embed stored documents (vectors from different models can't be mixed):
#   docker compose exec backend python -m src.scripts.reindex_embeddings
#   docker compose restart backend
EMBEDDING_PROVIDER=qwen
QWEN_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Shared vector size for all providers (Qwen3-0.6B max = 1024)
EXPECTED_EMBEDDING_DIM=1024
# Dev only: store fake vectors when no embedding key works (ruins search quality)
ALLOW_MOCK_EMBEDDINGS=false

# Database & Storage
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/agent_chatbot
DB_POOL_MIN=2
DB_POOL_MAX=10
# Docker host port binding for PostgreSQL (e.g. 127.0.0.1:5433 to keep it local-only)
DB_PORT_BIND=5432
AZURE_STORAGE_CONNECTION_STRING=
AZURE_CONTAINER_NAME=documents
DEV_STORAGE_LOCAL_PATH=./storage/blobs

# Security & Authentication
DEV_AUTH_BYPASS=true
JWT_SECRET=super-secret-key-change-in-production
JWT_ALGORITHM=HS256
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
MAX_UPLOAD_MB=50

# Agent & Loop Guardrails
MAX_AGENT_ITERATIONS=5
TOOL_TIMEOUT_SECONDS=15
# Human-in-the-loop: tools not marked read-only wait for Approve/Reject in the chat
TOOL_APPROVAL_REQUIRED=true
APPROVAL_TTL_MINUTES=30
RERANKING_ENABLED=true
RERANK_TOP_K=5
CHAT_HISTORY_MESSAGES=10
# Docker build: false = smaller backend image without reranker/Docling
INSTALL_ML=true

# GitHub Copilot & Cloud MCP Integration
GITHUB_PAT=your-github-pat-token-here
GITHUB_USERNAME=your-github-username-here
